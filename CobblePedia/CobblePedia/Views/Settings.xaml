<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CobblePedia.Views.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CobblePedia.Views"
    xmlns:model="using:CobblePedia.ViewModels"
    x:DataType="model:CobblePediaViewModel"
    mc:Ignorable="d">

  <Grid Style="{StaticResource PageGrid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock x:Uid="Settings"
               Grid.Row="0" Grid.Column="0"
               Style="{ThemeResource TitleTextBlockStyle}"
               AutomationProperties.HeadingLevel="Level1"
               Margin="40,36,36,0" />
    <ScrollView Grid.Row="1" Grid.Column="0"
                Padding="36,0,36,0"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
      <Border>
        <StackPanel Orientation="Vertical">
          <TextBlock x:Uid="UISettings"
               Style="{ThemeResource BodyStrongTextBlockStyle}"
               AutomationProperties.HeadingLevel="Level2"
               Margin="1,30,0,6" />
          <Grid Style="{StaticResource CardSettings}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Glyph="&#xF2B7;" 
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="16,16,12,16"
                      Grid.Column="0" Grid.Row="0"/>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="1" Grid.Row="0">
              <TextBlock x:Uid="ApplicationLanguage"
                         Style="{ThemeResource BodyTextBlockStyle}"
                         AutomationProperties.HeadingLevel="Level3"
                         Margin="0,0,8,0 "/>
              <TextBlock x:Uid="ApplicationLanguageInstructions"
                         Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <ComboBox x:Name="ApplicationLanguageComboBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      Grid.Column="2" Grid.Row="0"
                      SelectionChanged="ApplicationLanguageComboBox_SelectionChanged">
              <ComboBoxItem x:Uid="Language-fr-FR" Tag="fr-FR"/>
              <ComboBoxItem x:Uid="Language-en-US" Tag="en-US"/>
            </ComboBox>
          </Grid>
          <Grid Style="{StaticResource CardSettings}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Glyph="&#xF2B7;" 
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="16,16,12,16"
                      Grid.Column="0" Grid.Row="0"/>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="1" Grid.Row="0">
              <TextBlock x:Uid="DataLanguage"
                         Style="{ThemeResource BodyTextBlockStyle}"
                         AutomationProperties.HeadingLevel="Level3" />
              <TextBlock x:Uid="DataLanguageInstructions"
                         Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <ComboBox x:Name="DataLanguageComboBox"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,16,0"
                      Grid.Column="2" Grid.Row="0"
                      SelectionChanged="DataLanguageComboBox_SelectionChanged">
              <ComboBoxItem x:Uid="Language-fr-FR" Tag="fr-FR"/>
              <ComboBoxItem x:Uid="Language-en-US" Tag="en-US"/>
            </ComboBox>
          </Grid>
          <Grid Style="{StaticResource CardSettings}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <FontIcon Glyph="&#xE790;"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="16,16,12,16"
                      Grid.Column="0" Grid.Row="0"/>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="1" Grid.Row="0">
              <TextBlock x:Uid="Theme"
                         Style="{ThemeResource BodyTextBlockStyle}"
                         AutomationProperties.HeadingLevel="Level3"
                         Margin="0,0,8,0 "/>
              <TextBlock x:Uid="ThemeInstructions"
                         Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
            <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      SelectedIndex="0"
                      Margin="0,0,16,0"
                      Grid.Column="2" Grid.Row="0"
                      SelectionChanged="ThemeComboBox_SelectionChanged">
              <ComboBoxItem x:Uid="Theme-System" Tag="System"/>
              <ComboBoxItem x:Uid="Theme-Light" Tag="Light"/>
              <ComboBoxItem x:Uid="Theme-Dark" Tag="Dark"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>
    </ScrollView>
  </Grid>
</Page>
