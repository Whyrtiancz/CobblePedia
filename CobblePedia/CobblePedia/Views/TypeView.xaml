<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CobblePedia.Views.TypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CobblePedia.Views"
    xmlns:model="using:CobblePedia.ViewModels"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

  <Page.Resources>

    <DataTemplate x:Key="TypeItem" x:DataType="model:SearchableObjectViewModel">
      <StackPanel Style="{StaticResource ItemCell}">
        <Image Source="{x:Bind Icon}" Style="{StaticResource MediumIcon}" />
        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MediumIconCaption}"/>
      </StackPanel>
    </DataTemplate>

  </Page.Resources>

  <Grid Style="{StaticResource PageGrid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    
    <TextBlock x:Uid="Types"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="{ThemeResource TitleBarTitleMargin}"
               AutomationProperties.HeadingLevel="Level1" />
    
    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                  Style="{StaticResource LeftScrollviewer}"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
      <ListView SelectedItem="{x:Bind ViewModel.SelectedTypeInList, Mode=TwoWay}"
                ItemsSource="{x:Bind ViewModel.TypeViewModels}"
                ItemTemplate="{StaticResource TypeItem}"
                SelectionMode="Single"
                Style="{StaticResource LeftListView}" />
    </ScrollViewer>

    <!-- Type sélectionné -->
    <TextBlock Text="{x:Bind ViewModel.SelectedType.PrimaryName}"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="{ThemeResource ContentDialogTitleMargin}"
               Grid.Column="1" Grid.Row="1" />
    
    <!-- Tableau des forces et faiblesses -->
    <local:TypeExtendedViewModel Grid.Column="1" Grid.Row="2" />
  </Grid>
</Page>
