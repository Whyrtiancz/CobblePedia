<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CobblePedia.Views.PokemonTypeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CobblePedia.Views"
    xmlns:model="using:CobblePedia.ViewModels"
    x:DataType="model:CobblePediaViewModel"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

  <Page.Resources>

    <DataTemplate x:Key="TypeItem" x:DataType="model:SearchableObjectViewModel">
      <StackPanel Style="{StaticResource ItemCell}">
        <Image Source="{x:Bind Icon}" Style="{StaticResource MediumIcon}" />
        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MediumIconCaption}"/>
      </StackPanel>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="TypePanelTemplate">
      <ItemsWrapGrid Orientation="Horizontal"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     ItemWidth="92"/>
    </ItemsPanelTemplate>

  </Page.Resources>

  <ScrollViewer HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">

    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Ligne 1 - Entête -->
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
              Grid.Column="0" Grid.Row="0">
        <TextBlock x:Uid="TypesDamageFourfoldCaption"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
              Grid.Column="1" Grid.Row="0">
        <TextBlock x:Uid="TypesDamageNoFrom"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>

      <!-- Ligne 1 - Corps -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
              Grid.Column="0" Grid.Row="1">
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}"
              Grid.Column="1" Grid.Row="1">
        <GridView ItemsSource="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.NoDamageFrom}"
                  ItemTemplate="{StaticResource TypeItem}"
                  ItemsPanel="{StaticResource TypePanelTemplate}"
                  Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level1Visibility}" />
      </Border>

      <!-- Ligne 2 - Entête -->
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
              Grid.Column="0" Grid.Row="2">
        <TextBlock x:Uid="TypesDamageDoubleCaption"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
              Grid.Column="1" Grid.Row="2">
        <TextBlock x:Uid="TypesDamageQuarterFrom"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>

      <!-- Ligne 2 - Corps -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
              Grid.Column="0" Grid.Row="3">
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}"
              Grid.Column="1" Grid.Row="3">
        <GridView ItemsSource="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.QuarterDamageFrom}"
                  ItemTemplate="{StaticResource TypeItem}"
                  ItemsPanel="{StaticResource TypePanelTemplate}"
                  Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level2Visibility}" />
      </Border>

      <!-- Ligne 3 - Entête -->
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
              Grid.Column="0" Grid.Row="4">
        <TextBlock x:Uid="TypesDamageHalfCaption"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
              Grid.Column="1" Grid.Row="4">
        <TextBlock x:Uid="TypesDamageHalfFrom"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>

      <!-- Ligne 3 - Corps -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
              Grid.Column="0" Grid.Row="5">
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}"
              Grid.Column="1" Grid.Row="5">
        <GridView ItemsSource="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.HalfDamageFrom}"
                  ItemTemplate="{StaticResource TypeItem}"                    
                  ItemsPanel="{StaticResource TypePanelTemplate}"
                  Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level3Visibility}" />
      </Border>

      <!-- Ligne 4 - Entête -->
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
              Grid.Column="0" Grid.Row="6">
        <TextBlock x:Uid="TypesDamageQuarterCaption"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
              Grid.Column="1" Grid.Row="6">
        <TextBlock x:Uid="TypesDamageDoubleFrom"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>

      <!-- Ligne 4 - Corps -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
              Grid.Column="0" Grid.Row="7">
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}"
              Grid.Column="1" Grid.Row="7">
        <GridView ItemsSource="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.DoubleDamageFrom}"
                  ItemTemplate="{StaticResource TypeItem}"                    
                  ItemsPanel="{StaticResource TypePanelTemplate}"
                  Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level5Visibility}" />
      </Border>

      <!-- Ligne 5 - Entête -->
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
              Grid.Column="0" Grid.Row="8">
        <TextBlock x:Uid="TypesDamageNoCaption"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>
      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
              Grid.Column="1" Grid.Row="8">
        <TextBlock x:Uid="TypesDamageFourfoldFrom"
                   Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
      </Border>

      <!-- Ligne 5 - Corps -->
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
              Grid.Column="0" Grid.Row="9">
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              Style="{StaticResource TableTitleBorder}"
              Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}"
              Grid.Column="1" Grid.Row="9">
        <GridView ItemsSource="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.FourfoldDamageFrom}"
                  ItemTemplate="{StaticResource TypeItem}"                    
                  ItemsPanel="{StaticResource TypePanelTemplate}"
                  Visibility="{x:Bind ViewModel.SelectedPokemon.TypeEfficiency.Level6Visibility}" />
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
