<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CobblePedia.Views.PokemonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CobblePedia.Views"
    xmlns:model="using:CobblePedia.ViewModels"
    x:DataType="model:CobblePediaViewModel"
    x:DefaultBindMode="OneTime"
    mc:Ignorable="d">

  <Grid Style="{StaticResource PageGrid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Main Title -->
    <TextBlock Text="Pokedex"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="{ThemeResource TitleBarTitleMargin}"
               AutomationProperties.HeadingLevel="Level1" />

    <!-- Pokemon list -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.RowSpan="4"
                  Style="{StaticResource LeftScrollviewer}"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">

      <ListView SelectionMode="Single" ItemsSource="{x:Bind ViewModel.SpeciesViewModels}" 
                  SelectedItem="{x:Bind ViewModel.SelectedSpecies, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="model:SpeciesViewModel">
            <StackPanel Orientation="Horizontal">
              <Image Source="{x:Bind FrontDefault}"
                     Style="{StaticResource SpeciesIcon}" />
              <StackPanel Orientation="vertical">
                <TextBlock Text="{x:Bind Name}"
                           Style="{StaticResource SpeciesName}"/>
                <TextBlock Text="{x:Bind Numero}"
                           FontSize="12epx"
                           Style="{StaticResource SpeciesName}"/>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

    </ScrollViewer>

    <!-- Pokemon -->
    <!-- Ligne 1 à 4 -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
           Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4" Grid.RowSpan="3" />
    <Border Style="{StaticResource TextCell}"
            Grid.Column="1" Grid.Row="1">
      <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Numero, Mode=OneWay}"
                 Style="{ThemeResource TitleTextBlockStyle}" />
      <!--Margin="{ThemeResource ContentDialogTitleMargin}"/>-->
    </Border>
    <Border Style="{StaticResource TextCell}"
            Grid.Column="2" Grid.Row="1">
      <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Name, Mode=OneWay}"
               Style="{ThemeResource TitleTextBlockStyle}" />
      <!--Margin="{ThemeResource ContentDialogTitleMargin}"/>-->
    </Border>
    <Border Style="{StaticResource TypesCell}"
            Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2">
      <StackPanel Orientation="Horizontal">
        <Image Source="{x:Bind ViewModel.SelectedSpecies.PrimaryType.Icon, Mode=OneWay}" Style="{StaticResource TypeIcon}" />
        <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.PrimaryType.Name, Mode=OneWay}"
                           Style="{StaticResource TypeName}"/>
        <Image Source="{x:Bind ViewModel.SelectedSpecies.SecondaryType.Icon, Mode=OneWay}" Style="{StaticResource TypeIcon}" />
        <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.SecondaryType.Name, Mode=OneWay}"
                           Style="{StaticResource TypeName}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource GenerationCell}"
            Grid.Column="1" Grid.Row="2">
      <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Generation.Name, Mode=OneWay}" 
                   Grid.Column="0" Grid.Row="0"/>
    </Border>
    <Border Style="{StaticResource GenerationCell}"
            Grid.Column="1" Grid.Row="3">
      <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Generation.Region, Mode=OneWay}" 
                   Grid.Column="1" Grid.Row="0"/>
    </Border>

    <!-- Description -->
    <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Description, Mode=OneWay}"
               Style="{StaticResource TableTitleBorder}"
               Margin="8,4,8,4"
               Grid.Column="2" Grid.Row="2" Grid.RowSpan="2"
               TextWrapping="Wrap"/>

    <!-- Sprites -->
    <Border Style="{StaticResource TextCell}"
            Grid.Column="3" Grid.Row="2" Grid.RowSpan="2">
      <FlipView Height="144" Width="256"
              BorderBrush="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" BorderThickness="1" 
              ItemsSource="{x:Bind ViewModel.SelectedSpecies.Sprites, Mode=OneWay}">
        <FlipView.ItemTemplate>
          <DataTemplate x:DataType="model:SpriteViewModel">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Image Height="128"
                   Grid.Column="0"
                   Source="{x:Bind FrontSprite}" />
              <Image Height="128" 
                   Grid.Column="1"
                   Source="{x:Bind BackSprite}" />
              <Border Background="{ThemeResource SystemFillColorNeutralBrush}" Height="24" VerticalAlignment="Bottom"
                    Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text="{x:Bind Name}"
                         FontSize="12epx"
                         Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}" 
                         Padding="4,4" 
                         HorizontalAlignment="Center"/>
              </Border>
            </Grid>
          </DataTemplate>
        </FlipView.ItemTemplate>
      </FlipView>
    </Border>

    <!-- Informations -->
    <ScrollViewer Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="3"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Expander Header="Physique"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Grid.Column="0" Grid.Row="0">
          <Expander.Content>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Taille"
                 Grid.Column="0" Grid.Row="1"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Height, Mode=OneWay}"
                   Grid.Column="1" Grid.Row="1"/>
              <TextBlock Text="Poids"
                 Grid.Column="2" Grid.Row="1"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.Weight, Mode=OneWay}"
                   Grid.Column="3" Grid.Row="1"/>
            </StackPanel>
          </Expander.Content>
        </Expander>
        <Expander Header="Reproduction et évolutions"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Grid.Column="0" Grid.Row="1">

          <Expander.Content>
            <StackPanel Orientation="Horizontal">
              <Image Source="{x:Bind ViewModel.SelectedSpecies.PreEvolution.FrontDefault}"
                     Style="{StaticResource SpeciesIcon}" />
              <StackPanel Orientation="vertical">
                <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.PreEvolution.Name}"
                           Style="{StaticResource SpeciesName}"/>
                <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.PreEvolution.Numero}"
                           FontSize="12epx"
                           Style="{StaticResource SpeciesName}"/>
              </StackPanel>
            </StackPanel>
          </Expander.Content>
        </Expander>
        <Expander Header="Entrainement et capture"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  Grid.Column="0" Grid.Row="2">

        </Expander>
        <Expander Header="Statistiques"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Grid.Column="0" Grid.Row="3">
          <Expander.Content>
            <Grid HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Attack"
                 Grid.Column="0" Grid.Row="0"/>
              <TextBlock Text="Special Attack"
                 Grid.Column="0" Grid.Row="1"/>
              <TextBlock Text="Defence"
                 Grid.Column="0" Grid.Row="2"/>
              <TextBlock Text="Special Defence"
                 Grid.Column="0" Grid.Row="3"/>
              <TextBlock Text="HP"
                 Grid.Column="0" Grid.Row="4"/>
              <TextBlock Text="Speed"
                 Grid.Column="0" Grid.Row="5"/>
              <TextBlock Text="Total"
                 Grid.Column="0" Grid.Row="6"/>

              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvAttack , Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="0"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvSpecialAttack, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="1"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvDefence, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="2"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvSpecialDefence, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="3"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvHP, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="4"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.EvSpeed, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="1" Grid.Row="5"/>

              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseAttack, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseAttack , Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="0" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseSpecialAttack, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseSpecialAttack, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="1" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseDefence, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseDefence, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="2" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseSpecialDefence, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseSpecialDefence, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="3" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseHP, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseHP, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="4" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseSpeed, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseSpeed, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="5" />
              <ProgressBar Minimum="0" Maximum="{x:Bind ViewModel.MaxBaseTotal, Mode=OneTime}"
                           Value="{x:Bind ViewModel.SelectedSpecies.BaseTotal, Mode=OneWay}"
                           Style="{StaticResource ProgressBarStat}"
                           Grid.Column="2" Grid.Row="6" />

              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseAttack , Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="0" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseSpecialAttack, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="1" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseDefence, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="2" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseSpecialDefence, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="3" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseHP, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="4" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseSpeed, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="5" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseTotal, Mode=OneWay}"
                         Style="{StaticResource ProgressBarValue}"
                         Grid.Column="2" Grid.Row="6" />

              <TextBlock Text="{x:Bind ViewModel.MaxBaseAttack, Mode=OneWay}"
                         HorizontalAlignment="Right"
                         Grid.Column="3" Grid.Row="0"/>
              <TextBlock Text="{x:Bind ViewModel.MaxBaseSpecialAttack, Mode=OneWay}"
                         HorizontalAlignment="Right"
                         Grid.Column="3" Grid.Row="1"/>
              <TextBlock Text="{x:Bind ViewModel.MaxBaseDefence, Mode=OneWay}"
                   HorizontalAlignment="Right"
                 Grid.Column="3" Grid.Row="2"/>
              <TextBlock Text="{x:Bind ViewModel.MaxBaseSpecialDefence, Mode=OneWay}"
                   HorizontalAlignment="Right"
                 Grid.Column="3" Grid.Row="3"/>
              <TextBlock Text="{x:Bind ViewModel.MaxBaseHP, Mode=OneWay}"
                   HorizontalAlignment="Right"
                 Grid.Column="3" Grid.Row="4"/>
              <TextBlock Text="{x:Bind ViewModel.MaxBaseSpeed, Mode=OneWay}"
                   HorizontalAlignment="Right"
                 Grid.Column="3" Grid.Row="5"/>
              <TextBlock Text="{x:Bind ViewModel.SelectedSpecies.BaseTotal, Mode=OneWay}"
                   HorizontalAlignment="Right"
                 Grid.Column="3" Grid.Row="6"/>
            </Grid>
          </Expander.Content>
        </Expander>
        <Expander Header="Capacité"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  Grid.Column="0" Grid.Row="4">

        </Expander>
        <Expander Header="Attaques"
                  IsExpanded="True"
                  HorizontalAlignment="Stretch"
                  Grid.Column="0" Grid.Row="5">

        </Expander>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
