<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CobblePedia.Views.TrainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:CobblePedia.Views"
    xmlns:model="using:CobblePedia.ViewModels"
    x:DataType="model:CobblePediaViewModel"
    x:DefaultBindMode="OneWay"
    mc:Ignorable="d">

  <Grid Style="{StaticResource PageGrid}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock x:Uid="trainers"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="{ThemeResource TitleBarTitleMargin}"
               AutomationProperties.HeadingLevel="Level1" />

    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                  Style="{StaticResource LeftScrollviewer}"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
      <Border>
        <ListView Style="{StaticResource LeftListView}"
                  SelectionMode="Single"
                  ItemsSource="{x:Bind ViewModel.TrainerViewModels}"
                  SelectedItem="{x:Bind ViewModel.SelectedTrainerInList, Mode=TwoWay}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="model:SearchableObjectViewModel">
              <StackPanel Orientation="Horizontal">
                <Image Source="{x:Bind Icon}"
                     Style="{StaticResource PokemonIcon}" />
                <StackPanel Orientation="vertical">
                  <TextBlock Text="{x:Bind Name}"
                           Style="{StaticResource PokemonName}"/>
                  <TextBlock Text="{x:Bind Label}"
                           FontSize="12epx"
                           Style="{StaticResource PokemonName}"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>
    </ScrollViewer>

    <!-- Type sélectionné -->
    <TextBlock Text="{x:Bind ViewModel.SelectedTrainer.Name}"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="{ThemeResource ContentDialogTitleMargin}"
               Grid.Column="1" Grid.Row="1" />

    <!-- Tableau des forces et faiblesses -->
    <ScrollViewer Grid.Column="1" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
      <GridView ItemsSource="{x:Bind ViewModel.SelectedTrainer.Teams}"
                HorizontalAlignment="Stretch">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid MaximumRowsOrColumns="6"
                             Orientation="Horizontal"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"/>
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>

        <GridView.ItemTemplate>
          <DataTemplate x:DataType="model:TrainerTeamViewModel">
            <StackPanel Orientation="Vertical"
                        Style="{StaticResource ItemCell}">
              <Image Source="{x:Bind Pokemon.Icon}" Style="{StaticResource PokemonLargeIcon}" />
              <TextBlock Text="{x:Bind Pokemon.Name}" Style="{StaticResource TypeName}"/>
              <Image Source="{x:Bind Move1.MoveTypeIcon}" Style="{StaticResource TypeIcon}" />
              <TextBlock Text="{x:Bind Move1.Name}" Style="{StaticResource TypeName}"/>
              <Image Source="{x:Bind Move2.MoveTypeIcon}" Style="{StaticResource TypeIcon}" />
              <TextBlock Text="{x:Bind Move2.Name}" Style="{StaticResource TypeName}"/>
              <Image Source="{x:Bind Move3.MoveTypeIcon}" Style="{StaticResource TypeIcon}" />
              <TextBlock Text="{x:Bind Move3.Name}" Style="{StaticResource TypeName}"/>
              <Image Source="{x:Bind Move4.MoveTypeIcon}" Style="{StaticResource TypeIcon}" />
              <TextBlock Text="{x:Bind Move4.Name}" Style="{StaticResource TypeName}"/>
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

    </ScrollViewer>

  </Grid>

</Page>
