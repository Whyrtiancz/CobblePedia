<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="SmallIcon" TargetType="Image">
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="2" />
  </Style>

  <Style x:Key="SmallIconCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10epx" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,2" />
  </Style>

  <Style x:Key="MediumIcon" TargetType="Image">
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MediumIconCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12epx" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,2" />
  </Style>

  <Style x:Key="NormalIcon" TargetType="Image">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style x:Key="NormalIconCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16epx" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,4" />
  </Style>
  
  <Style x:Key="LargeIcon" TargetType="Image">
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style x:Key="LargeIconCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20epx" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,4" />
  </Style>
  
  <Style x:Key="VeryLargeIcon" TargetType="Image">
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style x:Key="VeryLargeIconCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24epx" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

</ResourceDictionary>
