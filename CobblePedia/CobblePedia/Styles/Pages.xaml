<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CobblePedia.Styles">

  <Style x:Key="PageGrid" 
         TargetType="Grid">
    <Setter Property="Margin" Value="40,24,36,36" />
  </Style>

  <Style x:Key="LeftScrollviewer"
         TargetType="ScrollViewer">
    <Setter Property="Margin" Value="0,36,36,0" />
  </Style>

  <Style x:Key="LeftListView"
         TargetType="ListView">
    <Setter Property="MinWidth" Value="192" />
  </Style>

  <Style x:Key="RightStackPanel"
         TargetType="StackPanel">
    <Setter Property="Margin" Value="36,36,0,0" />
  </Style>

  <Style x:Key="TableTitleBorder" 
         TargetType="Border">
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="TypeIcon"
         TargetType="Image">
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  
  <Style x:Key="TypeName"
         TargetType="TextBlock">
    <Setter Property="Width" Value="60" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style x:Key="ItemCell"
         TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  
  <!-- PokemonView -->
  <Style x:Key="PokemonName"
         TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,0,0" />
  </Style>

  <Style x:Key="PokemonNumber"
         TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="12epx" />
  </Style>

  <Style x:Key="PokemonIcon"
         TargetType="Image">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <Style x:Key="PokemonLargeIcon"
         TargetType="Image">
    <Setter Property="Height" Value="64" />
    <Setter Property="Margin" Value="2,2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TextCell"
         TargetType="Border">
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TypesCell"
         TargetType="Border">
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="GenerationCell"
         TargetType="Border">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="DescriptionCell"
         TargetType="Border">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="ProgressBarStat"
         TargetType="ProgressBar">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Margin" Value="8, 2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="ProgressBarValue"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="10epx" />
    <Setter Property="Margin" Value="0, 2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
